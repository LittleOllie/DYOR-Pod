# =============================================================================
# DYOR Website — Environment Variables
# Copy to `.env.local` for local development. Set the same keys in Vercel for production.
# Never commit `.env` or `.env.local`.
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED — Public website
# Production canonical URLs, OG tags, sitemap, and JSON-LD depend on this.
# Example: https://www.dyorpod.com
# -----------------------------------------------------------------------------
# Local dev: http://localhost:3002  |  Production: https://www.dyorpod.com
NEXT_PUBLIC_SITE_URL=

# -----------------------------------------------------------------------------
# OPTIONAL — Analytics (client-safe IDs only; no secrets)
# Supported: plausible | fathom | ga
# Events no-op safely when provider is unset or misconfigured.
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_ANALYTICS_PROVIDER=plausible
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=dyorpod.com
# NEXT_PUBLIC_FATHOM_SITE_ID=
# NEXT_PUBLIC_GA_MEASUREMENT_ID=

# -----------------------------------------------------------------------------
# REQUIRED FOR ADMIN — Library & schedule editing
# Generate secrets locally: openssl rand -base64 32
# Generate password locally: openssl rand -base64 24
# -----------------------------------------------------------------------------
ADMIN_ALLOWED_EMAILS=peteyk@dyorpod.com,dw@dyorpod.com
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# -----------------------------------------------------------------------------
# REQUIRED FOR ADMIN DATA — Upstash Redis (Vercel Storage integration)
# Without Redis: site uses static schedule/library; admin writes are unavailable.
# Vercel often provides: KV_REST_API_URL + KV_REST_API_TOKEN
# Upstash-named aliases also work: UPSTASH_REDIS_REST_URL + UPSTASH_REDIS_REST_TOKEN
# -----------------------------------------------------------------------------
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# -----------------------------------------------------------------------------
# OPTIONAL — Web Push Space reminders (server-side delivery)
# Generate keys locally: node scripts/generate-vapid-keys.mjs
# CRON_SECRET: openssl rand -base64 32
# Set the same value in Vercel env and GitHub repo secret (Actions → Send Space reminders).
# -----------------------------------------------------------------------------
NEXT_PUBLIC_WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:hello@dyorpod.com
CRON_SECRET=

# -----------------------------------------------------------------------------
# OPTIONAL — Newsletter signup
# With Redis configured (above), signups are stored in admin → Enquiries automatically.
# Optionally forward to Mailchimp or a custom endpoint as well.
# Without Redis or external provider: signup shows a friendly "not configured" message (503).
# Provider: mailchimp | convertkit | buttondown | webhook
# -----------------------------------------------------------------------------
NEWSLETTER_PROVIDER=mailchimp
NEWSLETTER_API_KEY=
NEWSLETTER_LIST_ID=
# NEWSLETTER_FORM_ENDPOINT=https://your-endpoint.com/subscribe

# -----------------------------------------------------------------------------
# OPTIONAL — Contact form
# With Redis configured (above), messages are stored in admin → Enquiries automatically.
# Optionally forward to Formspree, Zapier, etc. via CONTACT_FORM_ENDPOINT as well.
# Without Redis or external endpoint: contact form shows a friendly "not configured" message (503).
# -----------------------------------------------------------------------------
CONTACT_FORM_ENDPOINT=
# CONTACT_WEBHOOK_URL=
